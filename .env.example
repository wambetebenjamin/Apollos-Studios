# Apollos Studios environment template
# Copy to .env.local for development. All variables are optional;
# the directory runs cleanly without them (forms fall back to honeypot + rate limiting).

# Public site URL (used for metadata, sitemap and canonical links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp number for the floating chat button (E.164 digits only, no +)
NEXT_PUBLIC_WHATSAPP_NUMBER=254112272061

# Google reCAPTCHA
# Set NEXT_PUBLIC_RECAPTCHA_VERSION to "3" (score based, invisible) or "2" (checkbox).
# Leave NEXT_PUBLIC_RECAPTCHA_SITE_KEY empty to run with honeypot + rate limiting.
NEXT_PUBLIC_RECAPTCHA_VERSION=3
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Optional webhook (POST, JSON) receiving /api/contact and /api/list-space submissions
FORMS_WEBHOOK_URL=
